/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=3600
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self';

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/app.js
  ! Cache-Control
  Cache-Control: no-cache

/calc.js
  ! Cache-Control
  Cache-Control: no-cache

/charts.js
  ! Cache-Control
  Cache-Control: no-cache

/db.js
  ! Cache-Control
  Cache-Control: no-cache

/styles/*
  ! Cache-Control
  Cache-Control: no-cache

/manifest.json
  ! Cache-Control
  Cache-Control: no-cache

/
  ! Cache-Control
  Cache-Control: no-cache

/index.html
  ! Cache-Control
  Cache-Control: no-cache
